# Copy to .env for local development

# ── Database ─────────────────────────────────────────────────────────────────
# Local dev: leave blank (uses file:stocksense.db automatically)
# Production (Vercel): set these to your Turso database credentials
# Get a free Turso DB at https://turso.tech — run: turso db create stocksense
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── ML Service ────────────────────────────────────────────────────────────────
# Local dev: http://localhost:5001 (Flask running locally)
# Production: URL of your Railway/Render deployment of ml/app.py
ML_SERVICE_URL=http://localhost:5001

# ── NewsAPI ───────────────────────────────────────────────────────────────────
# https://newsapi.org/register  (free: 100 req/day)
NEWS_API_KEY=

# ── Reddit API ────────────────────────────────────────────────────────────────
# https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=StockSenseAI/0.1 by YourUsername

# ── Claude API ────────────────────────────────────────────────────────────────
# https://console.anthropic.com  (~$0.003 per prediction reasoning summary)
ANTHROPIC_API_KEY=

# ── X/Twitter API ─────────────────────────────────────────────────────────────
# Optional — $100/mo X Basic tier. Leave blank to skip Twitter scraping.
TWITTER_BEARER_TOKEN=

# ── Scheduler ─────────────────────────────────────────────────────────────────
# Default: 7:00 AM daily. Cron format (overridden by Settings page in the UI).
CRON_SCHEDULE=0 7 * * *
