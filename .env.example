# Copy to .env for local development

# ── Auth ──────────────────────────────────────────────────────────────────────
# A secret code required to log in to the app. Set anything you like.
ACCESS_CODE=change-me

# ── Database (Supabase) ───────────────────────────────────────────────────────
# Create a free project at https://supabase.com, then:
#   1. Copy the Project URL and service_role key from Settings → API
#   2. Run supabase/schema.sql once in the SQL Editor
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── ML Service ────────────────────────────────────────────────────────────────
# Local dev: http://localhost:5001 (Flask running locally)
# Production: URL of your HuggingFace Space deployment
ML_SERVICE_URL=http://localhost:5001

# ── NewsAPI ───────────────────────────────────────────────────────────────────
# https://newsapi.org/register  (free: 100 req/day)
NEWS_API_KEY=

# ── Reddit API ────────────────────────────────────────────────────────────────
# https://www.reddit.com/prefs/apps  (optional — RSS fallback used if blank)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=StockSenseAI/0.1 by YourUsername

# ── Claude API ────────────────────────────────────────────────────────────────
# https://console.anthropic.com  (~$0.003 per prediction reasoning summary)
ANTHROPIC_API_KEY=

# ── X/Twitter API ─────────────────────────────────────────────────────────────
# Optional — $100/mo X Basic tier. Leave blank to skip Twitter scraping.
TWITTER_BEARER_TOKEN=

# ── Scheduler ─────────────────────────────────────────────────────────────────
# Default: 7:00 AM daily. Cron format (overridden by Settings page in the UI).
CRON_SCHEDULE=0 7 * * *
